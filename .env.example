# Copy to .env.local and fill in. Every variable is validated in src/config/env.ts.
# NEXT_PUBLIC_* values are built into the browser bundle: never put secrets in them.
# Defaults in env.ts work for local development with `docker compose up -d`.

# Public URL of the app (sign-in happens here). No trailing slash.
APP_URL=http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Postgres (docker-compose.yml starts one on 5432)
DATABASE_URL=postgres://omnisuite:omnisuite@localhost:5432/omnisuite

# Better Auth secret: 32+ random characters. Required in production: the server refuses to start
# with the public development default (and docker-compose.prod.yml requires it). Generate: node -e "console.log(crypto.randomBytes(32).toString('base64'))"
BETTER_AUTH_SECRET=

# Google OAuth client (Google Cloud Console → Google Auth Platform → Clients)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Email + password sign-in (true/false)
AUTH_EMAIL_PASSWORD=true

# Development only: one-click sign-in as seeded demo users (never active in production)
DEV_LOGIN=true

# Platform admins (comma-separated emails)
PLATFORM_ADMIN_EMAILS=omniscope.digital@gmail.com

# 32-byte key, base64. Required in production, like BETTER_AUTH_SECRET. Generate: node -e "console.log(crypto.randomBytes(32).toString('base64'))"
ENCRYPTION_KEY=

# Email (Mailpit locally: inbox at http://localhost:8025)
SMTP_URL=smtp://localhost:1025
MAIL_FROM=OmniSuite <no-reply@omniscopedigital.com>

# Uploaded files
FILE_STORAGE_DIR=./storage
MAX_UPLOAD_MB=25

# Shared secret for Caddy's on-demand TLS check (deploy/Caddyfile). 32+ random characters; put the
# same value in the .env next to docker-compose.prod.yml. Empty: only internal requests are answered.
DOMAIN_CHECK_SECRET=

# Custom domains: tenants CNAME their domain to this host
CUSTOM_DOMAIN_TARGET=tenants.omniscopedigital.com
# Use X-Forwarded-Host as the request host. Only behind a proxy that rewrites Host (Caddy doesn't).
TRUST_FORWARDED_HOST=false

# Background jobs run inside the web process (true/false)
WORKER_ENABLED=true
# Apply database migrations when the server starts.
AUTO_MIGRATE=true

# --- Phase 7 (all optional; leave empty to keep the feature off) ---
# Platform subscription billing (Stripe Dashboard → Developers → API keys / Webhooks)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_STARTER=
STRIPE_PRICE_GROWTH=
STRIPE_PRICE_SCALE=
# Xero (developer.xero.com → My Apps; redirect URI <APP_URL>/api/xero/callback)
XERO_CLIENT_ID=
XERO_CLIENT_SECRET=
# AI features. Which provider and model each feature uses: src/config/ai.ts.
# Claude API key (platform.claude.com → API keys). The default provider.
ANTHROPIC_API_KEY=
# Optional second provider: any OpenAI-style /chat/completions server (OpenAI, OpenRouter,
# Groq, DeepSeek, Gemini's OpenAI endpoint; any value for local Ollama). Base URL and
# model are in src/config/ai.ts. Unused unless a feature there picks "openai-compatible".
OPENAI_COMPATIBLE_API_KEY=
# Exchange rates for "Use today's rate": open-er-api (default, free, no key) or off
FX_PROVIDER=

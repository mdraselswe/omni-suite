# Caddy in front of OmniSuite on the VPS (see docs/deployment.md).
# - APP_HOST (e.g. app.omniscopedigital.com) always gets a certificate.
# - Any other host gets one on demand, but only after the app confirms it is a
#   verified tenant domain (/api/domains/allowed). Random hosts are refused.
#   DOMAIN_CHECK_SECRET (same value as in .env.production) proves the ask comes from Caddy.
{
	email {$ACME_EMAIL}
	on_demand_tls {
		ask http://app:3000/api/domains/allowed/?secret={$DOMAIN_CHECK_SECRET}
	}
}

{$APP_HOST} {
	encode zstd gzip
	reverse_proxy app:3000
}

https:// {
	tls {
		on_demand
	}
	encode zstd gzip
	reverse_proxy app:3000
}
